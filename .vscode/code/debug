import pandas as pd
import sqlite3
from datetime import datetime, timedelta

def get_weekly_summary(db_path="bets.db"):
    conn = sqlite3.connect(db_path)
    # Load all bets
    df = pd.read_sql("SELECT * FROM bets", conn)
    df['timestamp'] = pd.to_datetime(df['timestamp'])
    
    # Filter for last 7 days
    one_week_ago = datetime.now() - timedelta(days=7)
    weekly_df = df[df['timestamp'] >= one_week_ago]
    
    # Calculate performance
    summary = {
        "Total Bets": len(weekly_df),
        "Win Rate": (weekly_df['result'] == 'win').mean(),
        "Net Profit": weekly_df['profit'].sum()
    }
    return summary
